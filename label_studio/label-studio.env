# Settings for the shared Label Studio server (loaded by start.sh).
# Public address that the Cloudflare tunnel serves.
HOST=https://ml-labeling.screendetox.co.in
CSRF_TRUSTED_ORIGINS=https://ml-labeling.screendetox.co.in
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
# Optional: only people with an invite link can sign up. Remove the # to turn on.
# DISABLE_SIGNUP_WITHOUT_LINK=1
LS_PORT=8080
# Cloudflare tunnel that serves the public address (started by start.sh if not already running).
TUNNEL_NAME=screendetox-tunnel

##start server
#./label_studio/start.sh